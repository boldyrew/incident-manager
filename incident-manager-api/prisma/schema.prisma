generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id          String           @id @default(uuid())
  code        String           @unique
  title       String
  description String?
  severity    IncidentSeverity
  status      IncidentStatus
  client      String
  assignedTo  String?
  detectedAt  DateTime
  tickets     Ticket[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@map("incidents")
}

model Ticket {
  id          String         @id @default(uuid())
  code        String         @unique
  title       String
  description String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?
  incidentId  String?
  incident    Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("tickets")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

