generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id             String           @id @default(uuid())
  code           String           @unique
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus
  client         String

  assignedUserId String?
  assignee       User?            @relation("IncidentAssignee", fields: [assignedUserId], references: [id])

  detectedAt     DateTime
  tickets        Ticket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenantId       String?
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])

  @@map("incidents")
}

model Ticket {
  id              String         @id @default(uuid())
  code            String         @unique
  title           String
  description     String?
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  incidentId      String?
  incident        Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignedUserId  String?
  assignee        User?          @relation("TicketAssignee", fields: [assignedUserId], references: [id])

  tenantId        String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id])

  @@map("tickets")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  ADMIN
  ANALYST
  CLIENT_USER
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  alias     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users     User[]
  incidents Incident[]
  tickets   Ticket[]

  @@map("tenants")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String
  fullName          String
  role              UserRole

  tenantId          String?
  tenant            Tenant?    @relation(fields: [tenantId], references: [id])

  assignedIncidents Incident[] @relation("IncidentAssignee")
  assignedTickets   Ticket[]   @relation("TicketAssignee")

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("users")
}
